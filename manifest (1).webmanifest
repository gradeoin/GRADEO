      "purpose": "maskable"
    },
    {
      "src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Gradeo — Grade Planner"
    },
    {
      "src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Gradeo — Desktop View"
    }
  ],
  "shortcuts": [
    {
      "name": "SGPA Calculator",
      "short_name": "SGPA",
      "description": "Calculate your SGPA instantly",
      "url": "/calculator/?mode=sgpa&source=shortcut",
      "icons": [
        {
          "src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "CGPA Planner",
      "short_name": "Planner",
      "description": "Plan your target CGPA",
      "url": "/calculator/?mode=planner&source=shortcut",
      "icons": [
        {
          "src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "CGPA Converter",
      "short_name": "CGPA",
      "description": "Convert SGPA to CGPA",
      "url": "/calculator/?mode=cgpa&source=shortcut",
      "icons": [
        {
          "src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/calculator/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/calculator/",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+gradeo",
      "url": "/calculator/?q=%s"
    }
  ]
}
