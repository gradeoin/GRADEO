{
  "name": "GRADEO Engineering Hub",
  "short_name": "Gradeo",
  "description": "Proprietary SGPA & CGPA planner for engineering students. Plan targets, calculate marks, and export verified grade cards.",
  "start_url": "/?source=pwa",
  "id": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "background_color": "#FFF6ED",
  "theme_color": "#FF6A00",
  "orientation": "portrait-primary",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["education", "utilities", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Target Planner",
      "short_name": "Planner",
      "description": "Plan your target CGPA",
      "url": "/calculators/planner/?source=shortcut",
      "icons": [{"src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png", "sizes": "96x96", "type": "image/png"}]
    },
    {
      "name": "SGPA Calculator",
      "short_name": "SGPA",
      "description": "Calculate your SGPA instantly",
      "url": "/calculators/sgpa/?source=shortcut",
      "icons": [{"src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png", "sizes": "96x96", "type": "image/png"}]
    },
    {
      "name": "CGPA Tracker",
      "short_name": "CGPA",
      "description": "Track your semester history",
      "url": "/calculators/cgpa/?source=shortcut",
      "icons": [{"src": "https://res.cloudinary.com/djy3mjtsz/image/upload/v1770296454/Untitled-2_i2ezfh.png", "sizes": "96x96", "type": "image/png"}]
    }
  ],
  "share_target": {
    "action": "/calculators/planner/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
